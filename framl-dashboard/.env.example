# Copy to .env.local for local development. Never commit real values.
# In Vercel, define these under Project Settings > Environment Variables.
# These variables are server-only (no NEXT_PUBLIC_ prefix), so they are never
# bundled into the JavaScript sent to the browser.

# Supabase project URL (must be HTTPS)
SUPABASE_URL=https://your-project-ref.supabase.co

# Low-privilege key only: anon (legacy) or publishable (sb_publishable_...).
# Never use the service_role or sb_secret_ key here.
SUPABASE_ANON_KEY=

# Optional: table to read (defaults to "transacciones")
SUPABASE_TABLE=transacciones
